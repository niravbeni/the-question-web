# Copy to .env.local for development.

# OpenAI — used for the facilitator chat, embeddings, moderation, and analysis.
OPENAI_API_KEY=sk-...

# Postgres connection string.
# Local dev:   postgresql://localhost:5432/tensions_dev
# Production:  the Supabase "Transaction pooler" URI, e.g.
#              postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://localhost:5432/tensions_dev

# Password for the /admin page and the manual recalibrate endpoint.
ADMIN_PASSWORD=choose-a-password

# Optional model overrides.
# OPENAI_CHAT_MODEL=gpt-5.6-terra
# OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
